-<script>
-  // --- In-memory data store for demo ---
-  const store = {
-    currentRole: null,
-    currentUser: null, // {role, username}
-    students: [],      // {username, name, regNo, branch, cgpa, skills[], resume}
-    openings: [],      // {id, company, role, skills[], ctc, details, postedBy}
-    applications: []   // {studentUsername, openingId, status: 'applied' | 'placed'}
-  };
-
-  // --- Helpers ---
-  function qs(id) { return document.getElementById(id); }
-  function bySel(sel) { return document.querySelector(sel); }
-  function createEl(tag, props = {}, children = []) {
-    const el = document.createElement(tag);
-    Object.assign(el, props);
-    children.forEach(c => el.appendChild(c));
-    return el;
-  }
-  function parseSkills(str) {
-    return (str || "")
-      .split(",")
-      .map(s => s.trim())
-      .filter(Boolean)
-      .map(s => s.toLowerCase());
-  }
-
-  // --- Role selection UI ---
-  const roleButtons = document.querySelectorAll(".role-button");
-  const loginSection = qs("loginSection");
-  const loginRoleInput = qs("loginRole");
-  const loginForm = qs("loginForm");
-  const loginUsername = qs("loginUsername");
-  const currentRoleLabel = qs("currentRoleLabel");
-  const currentUserLabel = qs("currentUserLabel");
-  const logoutBtn = qs("logoutBtn");
-  const pageTitle = qs("pageTitle");
-  const pageSubtitle = qs("pageSubtitle");
-
-  function setRole(role) {
-    store.currentRole = role;
-    roleButtons.forEach(btn => {
-      btn.classList.toggle("active", btn.dataset.role === role);
-    });
-
-    loginRoleInput.value = role === "recruiter" ? "Recruiter"
-      : role === "student" ? "Student"
-      : "Placement Cell";
-
-    currentRoleLabel.textContent = "Selected role: " + loginRoleInput.value;
-    pageTitle.textContent = loginRoleInput.value + " · Login";
-    pageSubtitle.textContent = "Authenticate to access your " + loginRoleInput.value + " dashboard.";
-
-    showSection("login");
-  }
-
-  roleButtons.forEach(btn => {
-    btn.addEventListener("click", () => setRole(btn.dataset.role));
-  });
-
-  logoutBtn.addEventListener("click", () => {
-    store.currentUser = null;
-    currentUserLabel.textContent = "Not logged in.";
-    logoutBtn.style.display = "none";
-    pageTitle.textContent = "Welcome";
-    pageSubtitle.textContent = "Select a role on the left to begin.";
-    showSection(null);
-  });
-
-  // --- Section visibility ---
-  function showSection(type) {
-    loginSection.style.display = type === "login" ? "block" : "none";
-    qs("recruiterSection").style.display = type === "recruiter" ? "block" : "none";
-    qs("studentSection").style.display = type === "student" ? "block" : "none";
-    qs("placementSection").style.display = type === "placement" ? "block" : "none";
-  }
-
-  // --- Login handling ---
-  loginForm.addEventListener("submit", (e) => {
-    e.preventDefault();
-    if (!store.currentRole) return;
-
-    const username = loginUsername.value.trim();
-    if (!username) return;
-
-    store.currentUser = { role: store.currentRole, username };
-    currentUserLabel.textContent = "Logged in as: " + username;
-    logoutBtn.style.display = "inline-flex";
-
-    if (store.currentRole === "recruiter") {
-      pageTitle.textContent = "Recruiter Dashboard";
-      pageSubtitle.textContent = "Post openings and discover matching candidates.";
-      showSection("recruiter");
-      renderCandidates();
-    } else if (store.currentRole === "student") {
-      pageTitle.textContent = "Student Dashboard";
-      pageSubtitle.textContent = "Maintain your profile and apply to companies.";
-      showSection("student");
-      renderCompanies();
-      loadExistingStudentProfile();
-    } else if (store.currentRole === "placement") {
-      pageTitle.textContent = "Placement Cell Dashboard";
-      pageSubtitle.textContent = "Monitor placements and optimize outcomes.";
-      showSection("placement");
-      renderPlacementOverview();
-      renderMatchingOptions();
-      renderMatchingResults();
-      renderPlacementStudentList();
-      renderChatWelcome();
-    }
-  });
-
-  // --- Recruiter: post requirements & list candidates ---
-  const postRequirementBtn = qs("postRequirementBtn");
-  postRequirementBtn.addEventListener("click", () => {
-    if (!store.currentUser || store.currentUser.role !== "recruiter") {
-      alert("Please login as a recruiter.");
-      return;
-    }
-
